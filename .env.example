# Backblaze B2 (required) — S3-compatible API only.
# The S3 endpoint is derived from B2_REGION: https://s3.<region>.backblazeb2.com
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region

# Optional: public base URL for objects (leave blank if the bucket is private).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=applicationKeyShownOnceAtCreation
# B2_BUCKET_NAME=my-receipts
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-receipts.s3.us-west-004.backblazeb2.com
